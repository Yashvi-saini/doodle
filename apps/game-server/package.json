{
  "name": "@doodle/game-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:memory": "tsx watch --clear-screen=false src/server.ts --memory",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@doodle/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@doodle/config": "workspace:*",
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
